+++ b/arch/x86/include/asm/traps.h	2026-11-01 15:56:06.167423165 +0000
@@ -57,4 +57,10 @@
 		local_irq_disable();
 }
 
+#ifdef CONFIG_X86_AVXEMU
+bool avxemu_handle_ud(struct pt_regs *regs);
+#else
+static inline bool avxemu_handle_ud(struct pt_regs *regs) { return false; }
+#endif
+
 #endif /* _ASM_X86_TRAPS_H */
